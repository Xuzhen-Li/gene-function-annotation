# =============================================================================
# config/example.env — copy to config/local.env and edit
# =============================================================================
# Beginner path: docs/QUICKSTART.md
# Stage products: docs/STAGE_IO.md
# Install DBs: docs/INSTALL_FUNCTIONAL.md
#
# MINIMUM for F1:
#   REPO_ROOT  WORK_DIR  PROTEINS_FA  DIAMOND_DB  FUNCTION_DIR
#   FUN_PREFIX  EGGNOG_TAX_SCOPE  BUSCO_LINEAGE_PROTEIN  RELEASE_TAG  THREADS
#
# Structural annotation (genome → GFF + proteins) lives in sibling
# gene-structure-annotation — do not keep EVM / BRAKER / S14 knobs here.
# Never commit local.env.
# =============================================================================

REPO_ROOT="/path/to/gene-function-annotation"
WORK_DIR="/path/to/work"
THREADS=32

# Required input: one representative protein per gene (from structure release or your own)
PROTEINS_FA="$WORK_DIR/proteins.faa"

# Optional locus context (not required for F1 master TSV)
CURATED_GFF="$WORK_DIR/curated.gff3"
DRAFT_GFF=""   # optional

GENOME_PREFIX="Species_v1.0"               # labels / rename if you still carry a GFF
RELEASE_TAG="species_fun.v0.1"

# ── Functional annotation (main product) ──
FUNCTION_DIR="$WORK_DIR/function"
FUN_PREFIX="ann"                         # output basename: ${FUN_PREFIX}_fun / ${FUN_PREFIX}_ips
DIAMOND_DB="/path/to/swissprot.dmnd"
EGGNOG_TAX_SCOPE="auto"                 # or a clade: Viridiplantae / Metazoa / Fungi / ...
BUSCO_LINEAGE_PROTEIN="eukaryota_odb10"  # F0 example; set the lineage for YOUR clade
BUSCO_OUT="$WORK_DIR/function/qc/busco_prot"
