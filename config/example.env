# =============================================================================
# config/example.env — copy to config/local.env and edit
# =============================================================================
# Beginner: docs/QUICKSTART.md · stage I/O: docs/STAGE_IO.md · DBs: docs/INSTALL_FUNCTIONAL.md
#
# ┌─ TONIGHT (classroom) — list these ~8 keys first ─────────────────────────┐
# │  WORK_DIR · PROTEINS_FA (→ structure release/<TAG>/proteins.faa)         │
# │  FUNCTION_DIR · RELEASE_TAG · THREADS · BUSCO_LINEAGE_PROTEIN            │
# │  DIAMOND_DB · EGGNOG_TAX_SCOPE  (placeholders OK tonight)                │
# │  Do not claim RUN=1 / F-L1. InterProScan home can wait until F1c.        │
# └─────────────────────────────────────────────────────────────────────────┘
# Full F1 also needs: REPO_ROOT · FUN_PREFIX · INTERPROSCAN_HOME · EGGNOG_DATA_DIR
# Structure (GFF) lives in sibling gene-structure-annotation — no BRAKER/S14 here.
# Never commit local.env.
# =============================================================================

REPO_ROOT="/path/to/gene-function-annotation"
WORK_DIR="/path/to/work"
THREADS=32

# Required input: one representative protein per gene.
# Prefer structure A6 alias: .../gene-structure-annotation/.../release/<TAG>/proteins.faa
# Do NOT point at a stale copy sitting only at structure WORK_DIR root unless that is intentional.
PROTEINS_FA="/path/to/gene-structure-annotation/work/release/YOUR_TAG/proteins.faa"
# Fallback if you already copied the alias next to FA work:
# PROTEINS_FA="$WORK_DIR/proteins.faa"

# Optional locus context (not required for F1 master TSV)
CURATED_GFF="$WORK_DIR/curated.gff3"
DRAFT_GFF=""   # optional

GENOME_PREFIX="Species_v1.0"               # labels / rename if you still carry a GFF
RELEASE_TAG="species_fun.v0.1"

# ── Functional annotation (main product) ──
FUNCTION_DIR="$WORK_DIR/function"
FUN_PREFIX="ann"                         # output basename: ${FUN_PREFIX}_fun / ${FUN_PREFIX}_ips
DIAMOND_DB="/path/to/swissprot.dmnd"
EGGNOG_TAX_SCOPE="auto"                 # or a clade: Viridiplantae / Metazoa / Fungi / ...
# Protein BUSCO lineage — MUST match a downloaded clade dataset (odb10 or odb12).
# Examples: viridiplantae_odb12 | poales_odb10 | metazoa_odb10. Do not leave YOUR_*; do not use bare eukaryota.
BUSCO_LINEAGE_PROTEIN="YOUR_BUSCO_LINEAGE_odb12"
BUSCO_OUT="$WORK_DIR/function/qc/busco_prot"
EGGNOG_DATA_DIR="/path/to/annot_dbs/eggnog"   # eggNOG-mapper data pack
# EGGNOG_SIF="/path/to/eggnog-mapper.sif"      # optional Singularity image
INTERPROSCAN_HOME="/path/to/annot_dbs/interproscan"  # dir containing interproscan.sh
# Same as INSTALL: often $DB_ROOT/interproscan
