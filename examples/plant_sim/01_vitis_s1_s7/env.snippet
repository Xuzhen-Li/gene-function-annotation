# Merge into config/local.env — placeholders only
REPO_ROOT="/path/to/gene-function-annotation"
WORK_DIR="/path/to/work"
FUNCTION_DIR="$WORK_DIR/function"
FUN_PREFIX="ann"
species_label=Vitis_vinifera_sim
PROTEINS_FA="/path/to/structure/release/Vitis_sim.v0.1/proteins.faa"
# proteins.faa = stable alias from structure 06_release (also <TAG>.proteins.faa)
BUSCO_LINEAGE_PROTEIN="viridiplantae_odb12"   # MUST set YOUR lineage — not bare eukaryota for plant papers
EGGNOG_TAX_SCOPE="Viridiplantae"
EGGNOG_DATA_DIR="/path/to/eggnog_data"
INTERPROSCAN_HOME="/path/to/interproscan"
DIAMOND_DB="/path/to/uniprot_sprot.dmnd"
RELEASE_TAG="Vitis_sim.fun.v0.1"
# Classroom minimum ≠ finish IPS tonight (see docs/START_HERE.md)
# want_nlr:true → F8_run.sh needs WORK_DIR+REPO_ROOT and IPS TSV (no RUN=1 dry mode)
# S7 families.tsv (structure) ≠ F8 nlr_candidates.tsv — convert via F8b_nlr_to_families.py if looping back
