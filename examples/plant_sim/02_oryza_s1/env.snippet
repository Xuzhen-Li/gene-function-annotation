REPO_ROOT="/path/to/gene-function-annotation"
WORK_DIR="/path/to/work"
FUNCTION_DIR="$WORK_DIR/function"
FUN_PREFIX="ann"
species_label=Oryza_sativa_sim
PROTEINS_FA="/path/to/structure/release/Oryza_sim.v0.1/proteins.faa"
# proteins.faa = stable alias from structure 06_release
# Pin SAME BUSCO odb generation as structure env (poales_odb10 vs viridiplantae_odb12) in METHODS
BUSCO_LINEAGE_PROTEIN="poales_odb10"   # or viridiplantae_odb12 — pin ONE generation with Compleasm/METHODS
EGGNOG_TAX_SCOPE="Viridiplantae"      # or Poaceae if you pin it
EGGNOG_DATA_DIR="/path/to/eggnog_data"
INTERPROSCAN_HOME="/path/to/interproscan"
DIAMOND_DB="/path/to/uniprot_sprot.dmnd"
RELEASE_TAG="Oryza_sim.fun.v0.1"
